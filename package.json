{
  "name": "campusclutch",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "eas-build-post-install": "node scripts/release/preview.cjs verify-build",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "db:local-test-emails": "supabase db query --local --file scripts/enable-test-email-signup.sql",
    "test:request-form": "node scripts/test-create-request-form.cjs",
    "test:request-details": "node scripts/test-request-details.cjs",
    "test:request-feed": "node --test scripts/test-request-feed.cjs",
    "test:home-navigation": "node --test scripts/test-home-dashboard.cjs scripts/test-bottom-navigation.cjs",
    "test:safety-reports": "node scripts/test-safety-reports.cjs && node scripts/test-report-draft.cjs",
    "test:safety-reports-local": "node scripts/test-safety-reports-local.cjs",
    "test:content-safety-reports-local": "node scripts/test-content-safety-reports-local.cjs",
    "test:moderation-triage-local": "node scripts/test-moderation-triage-local.cjs",
    "test:moderation": "node scripts/test-moderation.cjs && node scripts/test-moderation-access.cjs && node scripts/test-moderation-enforcement.cjs && node scripts/test-moderation-appeals.cjs",
    "test:moderation-appeals-local": "node scripts/test-moderation-appeals-local.cjs",
    "test:staff-recovery-local": "node scripts/test-staff-recovery-local.cjs",
    "test:moderation-enforcement-local": "node scripts/test-moderation-enforcement-local.cjs",
    "test:moderation-browser": "expo export --clear --platform web --max-workers 1 --output-dir .expo/task14-web && node scripts/test-moderation-browser.cjs",
    "test:student-blocks": "node scripts/test-student-blocks.cjs && node scripts/test-block-student-control.cjs",
    "test:student-blocks-local": "node scripts/test-student-blocks-local.cjs",
    "test:offers-lifecycle": "node scripts/test-request-offers-lifecycle.cjs",
    "test:auth-runtime": "node scripts/test-supabase-runtime.cjs && node --test scripts/test-private-drafts.cjs",
    "test:auth-ui": "node scripts/test-signup-screen.cjs && node --test scripts/test-sign-in-screen.cjs scripts/test-session-recovery.cjs scripts/test-auth-routing.cjs",
    "test:starter-grants-concurrency": "python scripts/test-starter-grants-concurrency.py",
    "test:messages-client": "node scripts/test-messages-client.cjs && node scripts/test-request-contacts-client.cjs && node scripts/test-group-conversations-client.cjs",
    "test:messages-ui": "node scripts/test-conversation-inbox.cjs && node scripts/test-message-thread.cjs && node scripts/test-message-thread-layout.cjs && node scripts/test-request-conversations-client.cjs && node scripts/test-message-entry-lifecycle.cjs && node scripts/test-classmate-message-entry.cjs && node scripts/test-unread-messages.cjs && node scripts/test-request-contact-entry.cjs && node scripts/test-group-messaging-ui.cjs && node scripts/test-group-create-screen.cjs && node scripts/test-group-app-integration.cjs",
    "test:messages-realtime": "node scripts/test-messages-realtime.cjs",
    "test:messages-local": "node scripts/test-messages-local.cjs && node scripts/test-messages-realtime-local.cjs",
    "test:messages-concurrency": "python scripts/test-messages-concurrency.py",
    "catalog:collect": "node scripts/sfu-catalog.cjs",
    "catalog:import": "node scripts/import-sfu-catalog.cjs",
    "test:catalog": "node scripts/test-sfu-catalog.cjs && node scripts/test-sfu-catalog-import.cjs && node scripts/test-course-catalog-client.cjs && node scripts/test-course-catalog-ui.cjs",
    "test:catalog-local": "node scripts/test-sfu-catalog-import.cjs --local && node scripts/test-course-catalog-local.cjs",
    "test:notifications": "node scripts/test-notifications-client.cjs && node scripts/test-notification-inbox.cjs && node scripts/test-notifications-ui.cjs && node scripts/test-notifications-provider.cjs && node scripts/test-android-push-worker.mjs",
    "test:notifications-local": "node scripts/test-notifications-local.cjs",
    "test:profiles": "node scripts/test-profile-interests.cjs && node --test scripts/test-profile-states.cjs scripts/test-student-profile-states.cjs",
    "test:loading": "node --test scripts/test-loading-state.cjs scripts/test-loading-gates.cjs",
    "test:motion": "node --test scripts/test-motion.cjs",
    "test:interface-usability": "node scripts/test-interface-usability.cjs",
    "test:student-journey-local": "node scripts/test-student-journey-local.cjs",
    "test:student-browser": "expo export --platform web --max-workers 1 --output-dir .expo/task12-web && node scripts/test-student-browser.cjs",
    "test:course-reviews": "node scripts/test-course-reviews-client.cjs && node scripts/test-course-reviews-ui.cjs",
    "test:course-reviews-local": "node scripts/test-course-reviews-local.cjs",
    "test:course-reviews-concurrency": "python scripts/test-course-reviews-concurrency.py",
    "test:account-deletion-local": "node scripts/test-account-deletion-local.cjs",
    "test:account-deletion-client": "node scripts/test-account-deletion-client.cjs && node scripts/test-account-deletion-screen.cjs",
    "test:account-deletion-cleanup-local": "node scripts/test-account-deletion-cleanup-local.cjs",
    "test:direct-moderation": "node scripts/test-direct-moderation.cjs && node scripts/test-direct-moderation-screen.cjs",
    "test:direct-moderation-local": "node scripts/test-direct-moderation-local.cjs",
    "test:email-verification-local": "node scripts/test-email-verification-local.cjs",
    "test:email-verification-browser": "expo export --platform web --max-workers 1 --output-dir .expo/email-verification-web && node scripts/test-email-verification-browser.cjs",
    "test:password-recovery": "node scripts/test-password-recovery.cjs && node --test scripts/test-forgot-password-screen.cjs",
    "test:password-recovery-local": "node scripts/test-password-recovery-local.cjs",
    "test:password-recovery-browser": "expo export --platform web --max-workers 1 --output-dir .expo/password-recovery-app && node scripts/test-forgot-password-browser.cjs",
    "test:legal-pages": "node --test scripts/test-legal-documents.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.8",
    "decode-uri-component": "file:./vendor/decode-uri-component-0.5.1.tgz",
    "base64-js": "1.5.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "playwright-core": "1.62.1",
    "serve-static": "1.16.3",
    "supabase": "^2.109.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "nanoid@^3.0.0": "3.3.20"
  },
  "private": true
}
